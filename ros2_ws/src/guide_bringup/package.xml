  <version>0.1.0</version>
  <description>Launch files, robot description and parameters for the SFU guide car</description>
  <maintainer email="alexthespacexfan@gmail.com">Alex Liu</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
